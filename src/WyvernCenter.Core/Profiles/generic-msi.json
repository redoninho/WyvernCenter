    "shiftMode": {
      "route": "scm",
      "class": "System",
      "index": 7,
      "mask": "0xFF",
      "values": {
        "comfort": "0xC1",
        "eco": "0xC2",
        "turbo": "0xC4"
      },
      "verified": true,
      "note": "MSI_System[7]. Values as on every MSI model in MSI's own software and the Linux msi-ec project. Written only if the current byte is 0xC0-0xC4 (the register really is the shift mode).",
      "expect": {
        "mask": "0xFF",
        "values": [
          "0xC0",
          "0xC1",
          "0xC2",
          "0xC3",
          "0xC4"
        ]
      },
      "testable": true
    },
    "fanMode": {
      "route": "scm",
      "class": "System",
      "index": 9,
      "mask": "0xFF",
      "values": {
        "auto": "0x0D",
        "silent": "0x1D",
        "advanced": "0x8D"
      },
      "verified": true,
      "note": "MSI_System[9]: auto 0x0D, silent 0x1D, advanced 0x8D (MSI's encoding). Written only if the current byte's low nibble is 0xD.",
      "expect": {
        "mask": "0x0F",
        "values": [
          "0x0D"
        ]
      }
    },
